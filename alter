#! /usr/bin/env nu

use modules/config.nu *
use modules/api.nu *

def main [] {
  help main
}

def "main login" [] {
  print "Alter is a selfhosted app, we need to know url of an instance you're using."
  let host = input "Host: " -d "https://alter.styxnotes.com"
  set host $host

  print $"\nCreate new token on: ($host)/api/v1/access_tokens"
  let access_token = input "Paste it here: "
  set access_token $access_token
}

def "main links" [--search(-s)] {
  if ($search) {
    fetch 'links' | input list -f
  } else {
    fetch 'links'
  }
}

def "main find link" [id: int] {
  fetch 'links' $id
}

def "main create link" [url ...tags] {
  post 'links' {url: $url, tags: ($tags | str join ' ')}
}

def "main edit link" [id: int ...tags --url(-u)=""] {
  patch 'links' $id {url: $url, tags: ($tags | str join ' ')}
}

def "main delete link" [id: int] {
  delete 'links' $id
}
